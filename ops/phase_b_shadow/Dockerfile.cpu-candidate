# Candidate only: external CPU image feasibility, NOT the Staging deployment Dockerfile.
# No model weights, user files, credentials or PDF contents enter this image.
FROM python:3.12-slim
WORKDIR /app
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
COPY requirements.txt requirements-phase-b.txt ./
RUN python -m pip install --index-url https://download.pytorch.org/whl/cpu \
      'torch==2.9.1+cpu' 'torchvision==0.24.1+cpu'
RUN python -m pip install -r requirements-phase-b.txt && python -m pip check
COPY extract_document_v2.py route_document_v2.py build_multimodal_chunks_v2.py source_registry_v1.yaml ./
COPY phase_b_shadow/ ./phase_b_shadow/
RUN useradd --uid 10001 --create-home worker
USER 10001:10001
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 CUDA_VISIBLE_DEVICES="" HOME=/tmp HF_HOME=/tmp/hf \
    XDG_CACHE_HOME=/tmp/.cache OMP_NUM_THREADS=1 MKL_NUM_THREADS=1
CMD ["celery", "-A", "phase_b_shadow.celery_app:app", "worker", "--loglevel=INFO", "--concurrency=1", "--queues=phase_b_shadow_pdf"]
